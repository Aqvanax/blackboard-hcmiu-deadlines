{
  "manifest_version": 3,
  "name": "Blackboard HCMIU Deadlines",
  "version": "1.0.0",
  "description": "Xuất deadline Blackboard HCMIU ra file .ics và đồng bộ Google Calendar.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://blackboard.hcmiu.edu.vn/webapps/calendar/*"],
      "js": ["bb.js"],
      "run_at": "document_idle"
    }
  ]
}
